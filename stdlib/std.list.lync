// =============================================================================
// std.list — Generic dynamic array for the Lync standard library.
//
// List<T> is a heap-backed growable array. Internally `items` carries the
// `own` modifier so ListFree releases it via `free l.items;`. Element
// width is recorded as `sizeof(T)` at construction time.
//
// Method-style call works on any List<T>:
//   xs: List<int> = ListNew<int>(4);
//   xs.Push(7);
//   xs.Set(0, 99);
//   xs.Free();
//
// Import entire module:   include std.list.*;
// Import single binding:  include std.list.ListPush;
// =============================================================================

// libc allocator decls. Use plain `ptr` rather than `own ptr` because
// the analyzer's move-tracking model rejects passing a struct field's
// `own ptr` value through realloc -- struct-field ownership flows
// aren't tracked yet. The API contract (ListNew pairs with ListFree)
// still encodes who owns the buffer; the type just doesn't enforce it
// across these specific extern boundaries.
extern <stdlib.h> {
    def malloc(n: usize): ptr;
    def realloc(p: ptr, n: usize): ptr;
}

extern <string.h> {
    def memcpy(dst: ptr, src: ptr, n: usize): ptr;
}

// Dynamic array of T. `items` carries `own` so ListFree can release it
// via Lync's `free l.items;` statement.
List<T>: struct {
    items: own ptr,
    count: int,
    cap: int,
    elem_size: usize
}

// Allocates a new List with at least initial_cap slots pre-reserved.
// Element width is captured via sizeof(T) -- caller never passes it.
def ListNew<T>(initial_cap: int): List<T> {
    cap: int = initial_cap;
    if (cap < 1) {
        cap = 8;
    }
    l: List<T>;
    l.elem_size = sizeof(T);
    l.count = 0;
    l.cap = cap;
    l.items = malloc(cap * l.elem_size);
    return l;
}

// Releases the heap buffer and zeroes the count/cap fields. Safe to
// call on an already-freed List (the items pointer is reset to null
// here so a second free is a no-op rather than UB; user code can also
// re-init via ListNew without leaking).
def ListFree<T>(l: ref List<T>): void {
    free l.items;
    l.count = 0;
    l.cap = 0;
}

// Internal: grow buffer to at least new_cap elements.
def _ListEnsureCap<T>(l: ref List<T>, new_cap: int): void {
    if (new_cap <= l.cap) {
        return;
    }
    grown: int = l.cap * 2;
    if (grown < new_cap) {
        grown = new_cap;
    }
    l.items = realloc(l.items, grown * l.elem_size);
    l.cap = grown;
}

// Appends v to the end, growing the buffer if needed.
def ListPush<T>(l: ref List<T>, v: T): void {
    _ListEnsureCap<T>(l, l.count + 1);
    slot: ptr = l.items + l.count * l.elem_size;
    memcpy(slot, addr_of(v), l.elem_size);
    l.count += 1;
}

// Sets count to 0 without freeing the buffer. Reuse-friendly.
def ListClear<T>(l: ref List<T>): void {
    l.count = 0;
}

// Removes the last element. Returns a borrowed pointer to the data slot
// (still inside the buffer; valid until the next push or free).
def ListPop<T>(l: ref List<T>): ptr? {
    if (l.count == 0) {
        return null;
    }
    l.count -= 1;
    return l.items + l.count * l.elem_size;
}

// Overwrites element at index i with v. No-op if out of bounds.
def ListSet<T>(l: ref List<T>, i: int, v: T): void {
    if (i < 0 || i >= l.count) {
        return;
    }
    slot: ptr = l.items + i * l.elem_size;
    memcpy(slot, addr_of(v), l.elem_size);
}

// Swap-remove element at index i (replaces with the last element). O(1).
// No-op if out of bounds.
def ListRemove<T>(l: ref List<T>, i: int): void {
    if (i < 0 || i >= l.count) {
        return;
    }
    last: int = l.count - 1;
    if (i != last) {
        dst: ptr = l.items + i * l.elem_size;
        src: ptr = l.items + last * l.elem_size;
        memcpy(dst, src, l.elem_size);
    }
    l.count -= 1;
}

// Returns a borrowed pointer to slot i, or null if out of bounds.
// Cast at the call site to read the value back as T.
def ListGet<T>(l: ref List<T>, i: int): ptr? {
    if (i < 0 || i >= l.count) {
        return null;
    }
    return l.items + i * l.elem_size;
}
