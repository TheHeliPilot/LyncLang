// =============================================================================
// std.mem — Low-level memory primitives for the Lync standard library.
//
// Thin wrappers over libc memcpy / memset. Use these from generic
// container code that walks raw heap buffers (the std.list internals
// already use this pattern via the new `addr_of(x)` + `ptr+int` +
// `sizeof(T)` primitives).
//
// Import entire module:   include std.mem.*;
// Import single binding:  include std.mem.MemCopy;
// =============================================================================

extern <stdlib.h> {
    def malloc(n: usize): ptr;
    def realloc(p: ptr, n: usize): ptr;
}

extern <string.h> {
    def memcpy(dst: ptr, src: ptr, n: usize): ptr;
    def memset(dst: ptr, value: int, n: usize): ptr;
}

// Allocate n bytes. Caller is responsible for freeing -- v1 ownership
// tracking on raw ptr is encoded by the API contract, not the type.
def Alloc(n: usize): ptr {
    return malloc(n);
}

// Resize an allocation in place. Returns the (possibly relocated) pointer.
def Realloc(p: ptr, n: usize): ptr {
    return realloc(p, n);
}

// Copy `count` BYTES from src to dst. To copy `n` elements of T, pass
// `n * sizeof(T)` as count.
def MemCopy(dst: ptr, src: ptr, count: usize): void {
    memcpy(dst, src, count);
}

// Set `count` bytes at dst to the byte `value`. To zero a struct of
// type T, pass `sizeof(T)` as count and 0 as value.
def MemSet(dst: ptr, value: int, count: usize): void {
    memset(dst, value, count);
}

// Swap two T-sized memory regions via a small temp buffer. Use addr_of
// at the call site to pass locals by address:
//     a: int = 1;
//     b: int = 2;
//     Swap<int>(addr_of(a), addr_of(b));
def Swap<T>(a: ptr, b: ptr): void {
    sz: usize = sizeof(T);
    tmp: ptr  = malloc(sz);
    memcpy(tmp, a, sz);
    memcpy(a,   b, sz);
    memcpy(b, tmp, sz);
    // tmp leaks until process exit -- struct fields can't carry `own` in
    // v1 to free a non-`own` ptr. Negligible for the few uses Swap sees.
}
