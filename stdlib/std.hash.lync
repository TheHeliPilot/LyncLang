// Query — STUBBED
// ---------------------------------------------------------------------------

// Returns the value associated with k as an own ptr proxy, or null.
// Original intended signature: def map_get<K, V>(...): V?
// Changed to own ptr because V? is not parseable for non-extern def functions.
def map_get<K, V>(m: ref HashMap<K, V>, k: K): own ptr {
    // TODO: blocked by sizeof and ptr arithmetic.
    return null;
}

// Returns true if k is present in the map.
// TODO: blocked by sizeof and ptr arithmetic.
def map_has<K, V>(m: ref HashMap<K, V>, k: K): bool {
