// =============================================================================
// std.string — String utilities for the Lync standard library.
//
// The Lync `string` type is an alias for C `char*`. Functions here treat
// strings as immutable null-terminated byte sequences.
//
// v1 SCOPE: only the inspection helpers (StrLen, StrEq, StrStartsWith,
// StrEndsWith, StrContains) are exposed. Construction helpers
// (concat, format, int->str) are blocked on a real String type with
// proper allocation, which lands in the next language pass.
//
// Import entire module:   include std.string.*;
// Import single binding:  include std.string.StrEq;
// =============================================================================

// strstr is exposed so StrContains / StrEndsWith have a fast path.
extern <stdio.h> {
    def strstr(haystack: string, needle: string): string?;
}

// Internal: compute length by walking to the null terminator. Avoids the
// libc strlen extern conflict (size_t vs int return).
def _StrLenInternal(s: string): int {
    n: int = 0;
    while (s[n] != 0) {
        n += 1;
    }
    return n;
}

// Returns the length of s in bytes, not including the null terminator.
def StrLen(s: string): int {
    return _StrLenInternal(s);
}

// Returns true if a and b contain identical byte sequences.
def StrEq(a: string, b: string): bool {
    la: int = _StrLenInternal(a);
    lb: int = _StrLenInternal(b);
    if (la != lb) {
        return false;
    }
    i: int = 0;
    while (i < la) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Returns true if s begins with prefix.
def StrStartsWith(s: string, prefix: string): bool {
    ls: int = _StrLenInternal(s);
    lp: int = _StrLenInternal(prefix);
    if (lp > ls) {
        return false;
    }
    i: int = 0;
    while (i < lp) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Returns true if s ends with suffix.
def StrEndsWith(s: string, suffix: string): bool {
    ls: int = _StrLenInternal(s);
    lsu: int = _StrLenInternal(suffix);
    if (lsu > ls) {
        return false;
    }
    // Compare the last lsu chars of s against suffix.
    offset: int = ls - lsu;
    i: int = 0;
    while (i < lsu) {
        if (s[offset + i] != suffix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Returns true if needle appears anywhere inside s.
def StrContains(s: string, needle: string): bool {
    match strstr(s, needle) {
        some(r): { return true; }
        null:    { return false; }
    };
    return false;
}
