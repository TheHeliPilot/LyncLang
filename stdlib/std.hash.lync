// =============================================================================
// std.hash — Hash functions for the Lync standard library.
//
// v1 SCOPE: HashInt + HashStr only. The full HashMap<K, V> table needs
// type-equality comparisons across generic K (currently blocked --
// `==` on a generic T isn't analyzed yet) and stable hashing for
// non-builtin K types. It'll land alongside the real String type.
//
// Import entire module:   include std.hash.*;
// Import single binding:  include std.hash.HashInt;
// =============================================================================

// Integer hash using Knuth multiplicative. Output is always non-negative.
def HashInt(k: int): int {
    h: int = k;
    if (h < 0) {
        h = 0 - h;
    }
    h = h * 2654435761;
    if (h < 0) {
        h = 0 - h;
    }
    return h;
}

// String hash using djb2: h = h*33 + c. Iterates to the null terminator.
def HashStr(s: string): int {
    h: int = 5381;
    i: int = 0;
    while (s[i] != 0) {
        h = h * 33 + s[i];
        i += 1;
    }
    if (h < 0) {
        h = 0 - h;
    }
    return h;
}
