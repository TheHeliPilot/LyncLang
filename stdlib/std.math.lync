// =============================================================================
// std.math — Math primitives for the Lync standard library.
//
// Provides generic Min/Max/Clamp/Abs/Lerp helpers and PascalCase wrappers
// over libc float math. Constants are exposed as zero-argument functions
// (Lync has no top-level const declarations).
//
// Import entire module:   include std.math.*;
// Import single binding:  include std.math.Sqrt;
// =============================================================================

// libc wrappers (lowercase to match the linker symbols). We expose the
// `double` overloads from <math.h> so plain `2.0` literals (which are
// double in Lync) work without explicit narrowing.
extern <math.h> {
    def sqrt(x: double): double;
    def floor(x: double): double;
    def ceil(x: double): double;
    def pow(x: double, y: double): double;
    def sin(x: double): double;
    def cos(x: double): double;
    def sqrtf(x: float): float;
    def sinf(x: float): float;
    def cosf(x: float): float;
}

// PascalCase public wrappers. Each name has a `double` and a `float`
// overload; the analyzer picks based on argument types and the codegen
// mangles them to distinct C symbols (Sqrt_double_double vs
// Sqrt_float_float). Plain literal arithmetic (`Sqrt(16.0)`) hits the
// double form; engine math that stays in 32-bit (`Sqrt(v.x)` where
// v.x is float) hits the float form.
def Sqrt(x: double): double         { return sqrt(x); }
def Sqrt(x: float):  float          { return sqrtf(x); }
def Floor(x: double): double        { return floor(x); }
def Ceil(x: double):  double        { return ceil(x); }
def Pow(x: double, y: double): double { return pow(x, y); }
def Sin(x: double):  double         { return sin(x); }
def Sin(x: float):   float          { return sinf(x); }
def Cos(x: double):  double         { return cos(x); }
def Cos(x: float):   float          { return cosf(x); }

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

def Pi():  float { return 3.14159265358979; }
def E():   float { return 2.71828182845905; }
def Inf(): float { return 1.0 / 0.0; }

// ---------------------------------------------------------------------------
// Generic helpers (duck-typed, monomorphised at compile time)
// ---------------------------------------------------------------------------

def Min<T>(a: T, b: T): T {
    if (a < b) { return a; }
    return b;
}

def Max<T>(a: T, b: T): T {
    if (a > b) { return a; }
    return b;
}

def Clamp<T>(v: T, lo: T, hi: T): T {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

def Abs<T>(v: T): T {
    if (v < 0) { return 0 - v; }
    return v;
}

def Lerp<T>(a: T, b: T, t: float): T {
    return a + (b - a) * t;
}
